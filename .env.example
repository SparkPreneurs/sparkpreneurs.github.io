# Public Google Apps Script web-app deployment URL (never a Stripe secret key).
PUBLIC_PA_DAY_CAMP_ENDPOINT=
# Local development: test by default; set live only when using a live backend.
# Production builds always require live mode.
PUBLIC_PA_DAY_CAMP_STRIPE_MODE=test

# Separate Winter Camp web app; private keys stay in Apps Script Properties.
PUBLIC_WINTER_CAMP_ENDPOINT=
PUBLIC_WINTER_CAMP_STRIPE_MODE=test

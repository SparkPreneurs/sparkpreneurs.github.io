---
import BaseLayout from '../layouts/BaseLayout.astro';
import RegistrationDiscount from '../components/RegistrationDiscount.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/after-school-registration.css';
import '../styles/after-school-theme.css';

const plans = [
  { code: 'AFTER3', name: '3 days/week', label: 'Flexible', price: 8400, description: 'For families who want a lighter after-school schedule.' },
  { code: 'AFTER4', name: '4 days/week', label: 'Balanced', price: 10400, description: 'For steady creative time through most of the school week.' },
  { code: 'AFTER5', name: '5 days/week', label: 'Full week', price: 12000, description: 'For families who need consistent weekday coverage.' },
];

const afternoonHighlights = [
  { number: '01', title: 'Make', detail: 'Explore hands-on creative projects in a welcoming studio.' },
  { number: '02', title: 'Move', detail: 'Include movement and active time as part of the afternoon.' },
  { number: '03', title: 'Connect', detail: 'Unwind and spend time with friends before family pick-up.' },
];

const registrationSteps = [
  { number: '01', title: 'Choose a weekly plan', detail: 'Select the 3-, 4-, or 5-day option that fits your family. Every registration begins with a four-week minimum.' },
  { number: '02', title: 'Share your details', detail: 'Enter the student and parent contact information needed to start registration.' },
  { number: '03', title: 'Complete secure payment', detail: 'The registration service validates the selected plan and total before opening Stripe Checkout.' },
];
---

<BaseLayout title="After-School Program | SparkPreneurs" description="Creative after-school care in Midtown Toronto, with weekly schedules, hands-on activities, and eligible neighbourhood school pick-up.">
  <a class="after-school-skip-link" href="#main-content">Skip to main content</a>
  <SiteHeader current="after-school" ctaHref="#register" ctaLabel="Register" />

  <main id="main-content" class="after-school-compact">
    <section class="camps-hero" aria-labelledby="after-school-title">
      <div class="programs-shell">

        <div class="camps-hero-grid">
          <div class="camps-hero-copy">
            <span class="eyebrow">AFTER-SCHOOL · MIDTOWN TORONTO</span>
            <h1 id="after-school-title">Good days don’t have to end at the <em>school bell.</em></h1>
            <p>Creative care where children can unwind, make things, move their bodies, and spend time with friends before family pick-up. Every option requires a minimum purchase of four weeks.</p>
            <div class="button-row">
              <a class="button button-primary" href="#register">View schedules & register →</a>

            </div>
          </div>
          <div class="camps-hero-visual">
            <figure class="camps-hero-main"><img src="/images/after-school-activity.png" alt="Children enjoying a creative SparkPreneurs activity" width="900" height="900" /></figure>
            <figure class="camps-hero-small"><img src="/images/gallery-kids-clay.jpg" alt="Children proudly showing their handmade clay projects" /></figure>
            <span aria-hidden="true">&#10022;</span>
          </div>
        </div>
      </div>
    </section>

    <section class="after-school-afternoon" aria-labelledby="afternoon-title">
      <div class="after-school-shell after-school-afternoon-layout">
        <div class="after-school-afternoon-heading"><span class="eyebrow">A CREATIVE AFTERNOON</span><h2 id="afternoon-title">Time to make, move, and connect.</h2><p>The program is designed as a supportive transition from school to home, with room for creativity, active time, and friendships.</p></div>
        <ol class="after-school-highlight-list">
          {afternoonHighlights.map((item) => <li><span>{item.number}</span><div><h3>{item.title}</h3><p>{item.detail}</p></div></li>)}
        </ol>
      </div>
    </section>

    <section id="register" class="after-school-register" data-after-school-shop data-program-code="after_school_program" data-minimum-weeks="4" data-endpoint="https://script.google.com/macros/s/AKfycbwtCEfAlRW_uljANPNBRf8X0ZuRLc_lpzdh4uowBp4P4mIQmJnqYS3grjiIwkG7hWlS/exec">
      <div class="after-school-shell">
        <div class="section-heading">
          <div><span class="eyebrow">SCHEDULE & REGISTRATION</span><h2>Pick your weekly rhythm.</h2></div>
          <p>Choose your plan and weeks, then add your family’s details. Afternoons run from 3–5 PM, with a four-week minimum.</p>
        </div>
        <p class="booking-fit-note">Before booking, confirm your child’s age/grade eligibility, school pick-up, and program dates. <a href="mailto:sparkpreneurs.ca@gmail.com">Ask us →</a></p>
        <ol class="registration-progress" aria-label="Registration progress"><li data-progress="1" aria-current="step"><span>1</span> Plan & dates</li><li data-progress="2"><span>2</span> Family & payment</li></ol>
        <div class="after-school-shop-grid">
          <div class="plan-grid" data-schedule-panel>
            {plans.map((plan) => (
              <article class="schedule-plan" data-plan data-code={plan.code} data-name={plan.name} data-price={plan.price}>
                <div class="plan-label-row"><span class="tag">{plan.label}</span></div><h3>{plan.name}</h3><p>{plan.description}</p>
                <div class="plan-bottom"><p class="plan-price">${plan.price / 100}<small>/week + HST</small></p><p class="minimum-price">4-week minimum: {(plan.price * 4 / 100).toLocaleString('en-CA', { style: 'currency', currency: 'CAD' })} + HST</p><button type="button" class="button button-ghost" data-select-plan>Select this option</button></div>
              </article>
            ))}
          </div>

          <aside class="registration-card" aria-labelledby="registration-title">
            <div class="registration-welcome"><span class="registration-spark" aria-hidden="true">✦</span><div><span class="eyebrow" data-step-caption>STEP 1 OF 2</span><h3 id="registration-title" tabindex="-1">When would you like to start?</h3></div></div>
            <div class="selected-plan" data-selected-plan aria-live="polite"><p>No weekly plan selected yet.</p></div>
            <form id="after-school-registration-form" data-registration-form novalidate>
              <fieldset class="registration-weeks">
                <legend class="sr-only">Choose your weeks</legend>
                <p id="week-help">Start with a Monday. We’ll line up your consecutive weeks from there.</p>
                <div class="registration-date-layout">
                <div class="booking-calendar" data-booking-calendar aria-label="Choose a starting Monday"></div>
                <div class="registration-duration-panel">
                <label>Starting Monday<input name="startDate" type="date" step="7" data-start-date required aria-describedby="week-help" /></label>
                <div class="week-duration"><label for="booking-week-count">How many weeks?<span>Four weeks is just the beginning.</span></label><div class="week-stepper"><button type="button" data-week-adjust="-1" aria-label="One fewer week">−</button><input id="booking-week-count" name="weekCount" type="number" min="4" max="52" step="1" value="4" data-week-count required /><button type="button" data-week-adjust="1" aria-label="One more week">+</button></div></div>
                <div class="week-shortcuts" aria-label="Quick week choices">{[4, 8, 12].map(weeks => <button type="button" data-week-preset={weeks} aria-pressed={weeks === 4 ? 'true' : 'false'}>{weeks} weeks</button>)}</div>
                <div data-week-summary aria-live="polite"></div>
                </div>
                </div>
              </fieldset>
              <fieldset class="registration-family" hidden disabled>
                <legend class="sr-only">A little about your family</legend>
                <p>All fields are required so we can confirm your registration.</p>
                <label>Child’s name<input name="studentName" type="text" autocomplete="section-student name" placeholder="First and last name" required /></label>
                <label>Parent or guardian’s name<input name="parentName" type="text" autocomplete="section-parent name" placeholder="First and last name" required /></label>
                <label>Email address<input name="parentEmail" type="email" autocomplete="email" placeholder="you@example.com" required /></label>
                <label>Phone number<input name="phone" type="tel" autocomplete="tel" placeholder="Your best contact number" required /></label>
                <RegistrationDiscount />
              </fieldset>
            </form>
            <div class="registration-totals" data-totals hidden><p><span data-subtotal-label>Subtotal (4 weeks)</span><strong data-subtotal></strong></p><p><span>HST</span><strong data-tax></strong></p><p class="total"><span>Total</span><strong data-total></strong></p></div>
            <p id="after-school-registration-note" class="registration-note">Need school pick-up? Contact us to confirm your school is eligible.</p>
            <p id="after-school-registration-status" class="registration-status" data-status role="status" aria-live="polite"></p>
            <div class="registration-actions">
              <button class="button button-ghost" type="button" data-back hidden>← Edit plan & dates</button>
              <button class="button button-primary" type="button" data-next disabled>Continue to family details →</button>
              <button class="button button-primary checkout-button" type="submit" form="after-school-registration-form" data-checkout aria-describedby="after-school-registration-note after-school-registration-status" hidden disabled>Continue to secure payment</button>
              <button class="clear-plan" type="button" data-clear disabled>Clear selection</button>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="after-school-registration-guide" aria-labelledby="registration-guide-title">
      <div class="after-school-shell">
        <div class="section-heading">
          <div><span class="eyebrow">HOW REGISTRATION WORKS</span><h2 id="registration-guide-title">From schedule to confirmation.</h2></div>
          <p>Registration is complete only after the payment session is verified. If secure checkout is unavailable, the page keeps payment disabled and directs families to contact SparkPreneurs.</p>
        </div>
        <ol class="after-school-step-grid">
          {registrationSteps.map((step) => <li><h3>{step.title}</h3><p>{step.detail}</p></li>)}
        </ol>
      </div>
    </section>

    <section class="after-school-faq" aria-labelledby="after-school-faq-title">
      <div class="after-school-shell after-school-faq-layout">
        <div><span class="eyebrow">COMMON QUESTIONS</span><h2 id="after-school-faq-title">Before you choose a plan.</h2><p>These answers use information already confirmed by the existing registration page. Missing operational details remain clearly identified.</p></div>
        <div class="after-school-faq-list">
          <details><summary>What are the program dates and closures?</summary><p>Contact SparkPreneurs to confirm the current program calendar and any closures before registering.</p></details>
          <details><summary>When is my registration confirmed?</summary><p>Your registration is confirmed after your payment is verified. The selected weeks are recorded with your payment.</p></details>
          <details><summary>What time does the program run?</summary><p>Every displayed weekly option runs from 3 PM to 5 PM.</p></details>
          <details><summary>How long is the minimum registration?</summary><p>Every option requires a minimum purchase of four weeks. Choose a starting Monday and four or more consecutive weeks. Your total covers the weeks shown in your registration.</p></details>
          <details><summary>How are the specific weekdays selected?</summary><p>[CONTENT REQUIRED FROM BUSINESS: available weekday combinations and how families confirm their selected days]</p></details>
          <details><summary>Is school pick-up available?</summary><p>Pick-up may be available from select neighbourhood schools. Contact SparkPreneurs before registering to confirm whether your school is eligible.</p></details>
          <details><summary>Which ages and grades can attend?</summary><p>[CONTENT REQUIRED FROM BUSINESS: exact eligible ages and grades]</p></details>
          <details><summary>What are the cancellation and late-pickup rules?</summary><p>[CONTENT REQUIRED FROM BUSINESS: approved registration, cancellation, transfer, missed-day, and late-pickup policies]</p></details>
        </div>
      </div>
    </section>

    <section class="after-school-help"><div class="after-school-shell"><div><span class="eyebrow">QUESTIONS?</span><h2>Let’s find the right schedule.</h2><p>We can help confirm school pick-up availability, timing, and registration details.</p></div><a class="button button-secondary" href="mailto:sparkpreneurs.ca@gmail.com">Contact SparkPreneurs</a></div></section>
  </main>

  <SiteFooter />

  <script src="../scripts/after-school.js"></script>
  <script is:inline>
    (() => {
      const menuButton = document.querySelector('[data-menu-button]');
      const menu = document.querySelector('[data-menu]');
      menuButton?.addEventListener('click', () => { const open = menuButton.getAttribute('aria-expanded') === 'true'; menuButton.setAttribute('aria-expanded', String(!open)); menu?.classList.toggle('is-open', !open); });
      menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menuButton?.setAttribute('aria-expanded', 'false'); menu.classList.remove('is-open'); }));
      document.addEventListener('keydown', event => { if (event.key !== 'Escape' || menuButton?.getAttribute('aria-expanded') !== 'true') return; menuButton.setAttribute('aria-expanded', 'false'); menu?.classList.remove('is-open'); menuButton.focus(); });


    })();
  </script>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { winterCamp, winterCampEmail } from '../../data/winter-camp';
import { paDayCamp } from '../../data/pa-day-camp';
import { Image } from 'astro:assets';
import paDayHero from '../../assets/camps/pa-day-camp-hero.png';
import winterHero from '../../assets/camps/winter-camp-hero.png';

const campActivities = [
  { number: '01', title: 'Create', detail: 'Explore art and creative projects through hands-on making.' },
  { number: '02', title: 'Move', detail: 'Balance focused creative time with movement and active experiences.' },
  { number: '03', title: 'Connect', detail: 'Spend school-break days creating alongside other young makers.' },
];
---

<BaseLayout
  title="Creative Camps for Kids | SparkPreneurs Toronto"
  description="Explore current creative school-break camp options for children at SparkPreneurs in Midtown Toronto and review the details families should confirm before registering."
>
  <a class="programs-skip-link" href="#current-camp">Skip to current camp</a>

  <SiteHeader current="camps" variant="programs" ctaHref={winterCamp.href} ctaLabel="Explore Winter Camp" />

  <main class="camps-page">
    <section class="camps-hero" aria-labelledby="camps-title">
      <div class="programs-shell">

        <div class="camps-hero-grid">
          <div class="camps-hero-copy">
            <span class="eyebrow">SCHOOL-BREAK PROGRAMS · MIDTOWN TORONTO</span>
            <h1 id="camps-title">Creative days beyond the <em>school day.</em></h1>
            <p>Make room for creativity during the school break. Explore our PA Day, Christmas, and Winter Break camps.</p>
            <div class="button-row">
              <a class="button button-primary" href={winterCamp.href}>Explore Winter Camp <span aria-hidden="true">→</span></a>
              <a class="button button-ghost" href="#current-camp">View All Camps <span aria-hidden="true">↓</span></a>
            </div>
          </div>
          <div class="camps-hero-visual" aria-hidden="true">
            <figure class="camps-hero-main"><img src="/images/kids.jpg" alt="Children enjoying a creative camp activity at SparkPreneurs" /></figure>
            <figure class="camps-hero-small"><img src="/images/gallery-kids-clay.jpg" alt="Children proudly showing their handmade clay projects" /></figure>
            <span>✦</span>
            <p><strong>Winter</strong><small>December 2026 camps</small></p>
          </div>
        </div>
      </div>
    </section>

    <section class="camps-task-switch" aria-label="Choose between Camps and After School">
      <div class="programs-shell">
        <p>What does your family need?</p>
        <a href="/camps/" aria-current="page"><span>01</span><strong>Camps</strong><small>School-break days</small></a>
        <a href="/after-school/"><span>02</span><strong>After School</strong><small>Recurring weekdays</small></a>
      </div>
    </section>

    <section id="current-camp" class="camps-current" aria-labelledby="current-camp-title">
      <div class="programs-shell">
        <div class="camps-section-heading">
          <div><span class="eyebrow">FIND YOUR NEXT SCHOOL BREAK</span><h2 id="current-camp-title">A season for making.</h2></div>
          <p>From a single PA day to a week of winter making, find a creative break that fits your family.</p>
        </div>
        <article class="camps-feature-card">
          <div class="camps-feature-image"><Image src={paDayHero} alt="Children painting colourful artwork together at creative camp" widths={[480, 800, 1200]} sizes="(max-width: 780px) 90vw, 45vw" format="webp" quality={80} loading="lazy" /><span>TDSB elementary · 2026–27</span></div>
          <div class="camps-feature-copy"><span class="eyebrow">A CREATIVE DAY OFF</span><h3>PA Day Camp</h3><p>Clay, creative crafts, and music make a school day off a day to remember. Select one PA day or several.</p><dl><div><dt>Camp day</dt><dd>8 AM–3 PM · $85/day</dd></div><div><dt>With extended care</dt><dd>8 AM–5 PM · $105/day</dd></div><div><dt>Choose your dates</dt><dd>TDSB elementary PA days · Studio confirms availability</dd></div></dl><a class="button button-secondary" href={paDayCamp.href}>Explore PA Day Camp <span aria-hidden="true">→</span></a></div>
        </article>
        <article class="camps-feature-card">
          <div class="camps-feature-image"><Image src={winterHero} alt="Children making snowflakes and painting winter ornaments at creative camp" widths={[480, 800, 1200]} sizes="(max-width: 780px) 90vw, 45vw" format="webp" quality={80} loading="lazy" /><span>December 2026 · Ages 4–12</span></div>
          <div class="camps-feature-copy">
            <span class="eyebrow">CHRISTMAS & WINTER BREAK</span>
            <h3>Winter Camp</h3>
            <p>Creative crafts, clay, and 3D printing bring a little extra magic to the winter school break. Choose one of two four-day camps.</p>
            <dl>
              <div><dt>Christmas Camp</dt><dd>December 21–24, 2026</dd></div>
              <div><dt>Winter Break Camp</dt><dd>December 28–31, 2026</dd></div>
              <div><dt>Camp day & extra care</dt><dd>8 AM–3 PM · Extended-care details vary by date</dd></div>
            </dl>
            <a class="button button-secondary" href={winterCamp.href}>View Winter Camp Details <span aria-hidden="true">→</span></a>
          </div>
        </article>
      </div>
    </section>

    <section class="camps-experience" aria-labelledby="camp-experience-title">
      <div class="programs-shell camps-experience-layout">
        <div><span class="eyebrow">THE CAMP EXPERIENCE</span><h2 id="camp-experience-title">Create, move, and connect.</h2><p>School breaks are a chance to explore something new. Discover the activities, ages, and schedule on each camp’s detail page.</p></div>
        <ol>
          {campActivities.map((activity) => <li><span>{activity.number}</span><div><h3>{activity.title}</h3><p>{activity.detail}</p></div></li>)}
        </ol>
      </div>
    </section>

    <section class="camps-gallery" aria-labelledby="camp-gallery-title">
      <div class="programs-shell">
        <div class="camps-section-heading compact"><div><span class="eyebrow">CREATIVE SCHOOL BREAKS</span><h2 id="camp-gallery-title">Time to explore.</h2></div><p>Camp experiences can bring together visual art, clay, creative technology, movement, and collaborative making.</p></div>
        <div class="camps-gallery-grid">
          <figure><img src="/images/kids.jpg" alt="Children taking part in a SparkPreneurs activity" loading="lazy" /></figure>
          <figure><img src="/images/gallery-kids-clay.jpg" alt="Children showing their clay projects" loading="lazy" /></figure>
          <figure><img src="/images/gallery-robotics.jpg" alt="A child working on a creative technology activity" loading="lazy" /></figure>
        </div>
      </div>
    </section>

    <section class="camps-faq" aria-labelledby="camp-faq-title">
      <div class="programs-shell camps-faq-layout">
        <div><span class="eyebrow">CAMP QUESTIONS</span><h2 id="camp-faq-title">Before you register.</h2><p>Explore each camp’s dates and details, then ask the studio for help choosing the right option.</p></div>
        <div class="camps-faq-list">
          <details><summary>What ages can attend?</summary><p>Winter Camp is for ages 4–12. Contact the studio to confirm age suitability for PA Day Camp.</p></details>
          <details><summary>When is Winter Camp?</summary><p>Christmas Camp runs December 21–24, 2026, and Winter Break Camp runs December 28–31, 2026. Both weeks have the same pricing: $320 per four-day week or $85 per day, before applicable taxes. Camp hours are 8 AM–3 PM, with extended care from 3–5 PM on December 21–23 and 28–30. <a href={winterCamp.href}>Explore Winter Camp.</a></p></details>
          <details><summary>What does a camp day include?</summary><p>The supported overview includes art, creativity, hands-on making, movement, and social time. Exact projects, themes, and daily schedules must be confirmed by session.</p></details>
          <details><summary>Are other school-break camps available?</summary><p>Contact SparkPreneurs to ask about future PA Day, March Break, and other school-break camp dates.</p></details>
          <details><summary>Where does camp take place?</summary><p>Camp is associated with the SparkPreneurs studio at 3445 Yonge Street, Second Floor, Toronto. Confirm any session-specific location details before attending.</p></details>
        </div>
      </div>
    </section>

    <section class="programs-help" aria-labelledby="camp-help-title">
      <div class="programs-shell">
        <div><span class="eyebrow">MAKE IT A CREATIVE WINTER</span><h2 id="camp-help-title">Join us this December.</h2><p>Email us with your child’s age and preferred camp. We’ll help with pricing, availability, and registration.</p></div>
        <a class="button button-light" href={winterCampEmail()}>Ask About Winter Camp →</a>
      </div>
    </section>
  </main>

  <SiteFooter />

  <style>
    .camps-feature-card + .camps-feature-card { margin-top: 30px; }
  </style>

  <script>
    const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    menuButton?.addEventListener('click', () => {
      const open = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!open));
      menu?.classList.toggle('is-open', !open);
    });
    menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      menuButton?.setAttribute('aria-expanded', 'false');
      menu.classList.remove('is-open');
    }));
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || menuButton?.getAttribute('aria-expanded') !== 'true') return;
      menuButton.setAttribute('aria-expanded', 'false');
      menu?.classList.remove('is-open');
      menuButton.focus();
    });
  </script>
</BaseLayout>

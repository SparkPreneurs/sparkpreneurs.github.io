---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import RegistrationDiscount from '../../components/RegistrationDiscount.astro';
import { Image } from 'astro:assets';
import winterHero from '../../assets/camps/winter-camp-hero.png';
import winterClay from '../../assets/camps/winter-camp-clay.png';
import winterPrinting from '../../assets/camps/winter-camp-3d-printing.png';
import { winterCamp, winterCampEmail, winterCampCheckout } from '../../data/winter-camp';

const registrationUrl = winterCampEmail();
const money = (cents: number) => new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD' }).format(cents / 100);
---

<BaseLayout title="Winter Camp Ages 4–12 | SparkPreneurs Toronto" description="Creative crafts, clay, and 3D printing for ages 4–12. Christmas Camp December 21–24 and Winter Break Camp December 28–31, 2026, in Toronto. Register by email.">
  <a class="programs-skip-link" href="#winter-dates">Skip to camp dates</a>
  <SiteHeader current="camps" variant="programs" ctaHref={registrationUrl} ctaLabel="Register by Email" />

  <main class="camps-page winter-camp-page" data-winter-shop data-endpoint={winterCampCheckout.endpoint} data-program-code={winterCampCheckout.programCode} data-stripe-mode={winterCampCheckout.stripeMode} data-tax-rate={winterCampCheckout.taxRatePercent ?? ''} data-tax-included={String(winterCampCheckout.taxIncluded)}>
    <section class="camps-hero" aria-labelledby="winter-title">
      <div class="programs-shell">
        <div class="camps-hero-grid">
          <div class="camps-hero-copy">
            <span class="eyebrow">WINTER CAMP · {winterCamp.ageLabel.toUpperCase()}</span>
            <h1 id="winter-title">A little winter magic. A whole lot of <em>making.</em></h1>
            <p>Fill the school break with creative crafts, clay, and 3D printing. Two four-day camps for curious young makers at our Midtown Toronto studio.</p>
            <div class="button-row">
              <a class="button button-primary" href="#winter-dates">Explore Camp Dates <span aria-hidden="true">→</span></a>
              <a class="button button-ghost" href="#winter-registration">Review Your Cart</a>
            </div>
          </div>
          <div class="camps-hero-visual" aria-label="Creative Winter Camp activities">
            <figure class="camps-hero-main">
              <Image src={winterHero} alt="Children making paper snowflakes and painting winter ornaments at a craft table" widths={[480, 800, 1200]} sizes="(max-width: 780px) 90vw, 45vw" format="webp" quality={80} loading="eager" fetchpriority="high" />
            </figure>
            <figure class="camps-hero-small">
              <Image src={winterClay} alt="Children shaping clay stars and a small winter tree with an instructor" widths={[240, 480, 640]} sizes="(max-width: 560px) 130px, 200px" format="webp" quality={80} loading="eager" />
            </figure>
            <figure class="camps-hero-small winter-hero-printing">
              <Image src={winterPrinting} alt="Two children and an instructor watching a winter star inside an enclosed 3D printer" widths={[240, 480, 640]} sizes="(max-width: 560px) 130px, 170px" format="webp" quality={80} loading="eager" />
            </figure>
            <span aria-hidden="true">&#10022;</span>
          </div>
        </div>
      </div>
    </section>

    <section class="camps-experience" aria-labelledby="winter-activities-title">
      <div class="programs-shell camps-experience-layout">
        <div><span class="eyebrow">A BREAK MADE FOR MAKING</span><h2 id="winter-activities-title">Craft it.<br />Shape it.<br />Print it.</h2><p>Three ways to explore creativity, all part of Winter Camp. A school break with room for imagination and hands-on discovery.</p></div>
        <ol>{winterCamp.activities.map((activity, index) => <li><span>0{index + 1}</span><div><h3>{activity.title}</h3><p>{activity.description}</p></div></li>)}</ol>
      </div>
    </section>

    <div class="winter-booking programs-shell" data-winter-booking>
      <div class="winter-booking-heading"><h2>Book your winter camp.</h2><p>Two weeks to choose from, with the same pricing each week. Book one week or both for your child.</p></div>
      <div class="winter-booking-tabs" role="tablist" aria-label="Camp enrollment" data-winter-tabs hidden>
        <button id="winter-camps-tab" type="button" role="tab" aria-controls="winter-dates" aria-selected="true" data-winter-tab="winter-dates">1. Choose camps</button>
        <button id="winter-details-tab" type="button" role="tab" aria-controls="winter-registration" aria-selected="false" tabindex="-1" data-winter-tab="winter-registration">2. Details &amp; payment</button>
      </div>
      <div class="winter-booking-columns">
    <section id="winter-dates" class="camps-current" aria-labelledby="winter-dates-title">
      <div class="programs-shell">
        <h2 id="winter-dates-title" class="sr-only">Dates &amp; camp options</h2>
        <div class="winter-date-grid">
          {winterCamp.sessions.map(session => (
            <article class="winter-date-card" aria-labelledby={`${session.id}-title`} data-winter-item data-code={session.code} data-name={session.title} data-dates={session.dates} data-price={session.priceCents ?? ''} data-care-hourly-price={session.careHourlyPriceCents ?? ''} data-care-days={session.careDays.join(',')} data-pickup-note={session.pickupNote}>
              <h3 id={`${session.id}-title`}>{session.title}</h3>
              <p class="winter-date-range"><time datetime={session.startDate}>December {session.dayNumbers[0]}</time>–<time datetime={session.endDate}>{session.dayNumbers[3]}, 2026</time></p>
              <p class="winter-session-hours">Mon–Thu · {winterCamp.hours} · Ages 4–12</p>
              {session.priceCents !== null && <div class="winter-booking-options">
                <div class="winter-week-price"><span><small>YOUR FOUR-DAY ADVENTURE</small><strong>Make it a full week.</strong><small>8 AM–3 PM · All four days included</small></span><b>{money(session.priceCents)}<small>per child</small></b></div>
                <div class="winter-care-options" aria-labelledby={`${session.id}-care-title`}>
                  <div class="winter-care-heading"><h4 id={`${session.id}-care-title`}>A little more time?</h4><span>OPTIONAL</span></div>
                  <p class="winter-care-help">Set your pickup time for each day. Extra care is {money(session.careHourlyPriceCents!)} per hour.</p>
                  {session.careDays.map((day, index) => <fieldset class="winter-pickup-day">
                    <legend><span>{['MON', 'TUE', 'WED'][index]}</span> December {day}<span class="sr-only"> · {session.title} pickup time</span></legend>
                    <div class="winter-pickup-tiles">{[0, 1, 2, 3].map(hours => <label class="winter-pickup-tile">
                      <input type="radio" name={`${session.id}-pickup-${day}`} value={hours} data-winter-pickup data-day={day} checked={hours === 0} />
                      <span><strong>{3 + hours} <small>PM</small></strong><em>{hours === 0 ? 'Included' : `+${money(session.careHourlyPriceCents! * hours)}`}</em></span>
                    </label>)}</div>
                  </fieldset>)}
                  <div class="winter-pickup-notice"><span class="winter-final-day">THU<strong>{session.dayNumbers.at(-1)}</strong></span><p><strong>Home for the holiday.</strong>December {session.dayNumbers.at(-1)} · 3 PM pickup only.<br />No extended care on this day.</p></div>
                </div>
                <dl class="winter-price-breakdown" aria-live="polite"><div><dt>Four-day camp</dt><dd>{money(session.priceCents)}</dd></div><div><dt>Extended care <span data-winter-care-hours>(0 hours)</span></dt><dd data-winter-care-total>{money(0)}</dd></div></dl>
                <details class="winter-camp-practical"><summary>Care, pickup &amp; what to bring</summary>
                  {session.careDays.length > 0 && <p class="winter-care-note">Extended care: {session.careHours}, December {session.careDays[0]}–{session.careDays.at(-1)} only · +{money(session.careHourlyPriceCents!)}/hour.</p>}
                  {session.pickupNote && <p class="winter-care-note"><strong>{session.pickupNote}</strong></p>}
                  <p class="winter-care-note">{session.foodNote}</p>
                </details>
              </div>}
              {session.priceCents === null && <div class="winter-price-pending"><strong>Planning for this week?</strong><p>Pricing and care details are being confirmed.</p><a href={winterCampEmail(session.title)}>Ask about this camp <span aria-hidden="true">↗</span></a></div>}
              <div class="winter-card-purchase">
                <p class="winter-card-price"><span data-winter-card-price>{session.priceCents === null ? 'Price to be confirmed' : money(session.priceCents)}</span><small data-winter-card-price-note>{session.priceCents === null ? 'Contact us for this camp’s pricing' : 'Per week · per child · before tax'}</small></p>
                <button class="button button-secondary" type="button" data-winter-add aria-pressed="false" aria-label={`Add ${session.title}, ${session.dates}, to cart`}>Add camp <span aria-hidden="true">+</span></button>
              </div>
            </article>
          ))}
        </div>
        <div class="winter-selection-footer"><div class="winter-selection-summary" role="status" aria-live="polite"><span data-winter-count>0 camps</span><strong data-winter-selection-total>No camps selected</strong></div><button class="winter-cart-link" type="button" data-winter-next disabled>Continue to details &amp; payment <span aria-hidden="true">→</span></button></div>
      </div>
    </section>

    <section id="winter-registration" class="winter-registration" aria-labelledby="winter-registration-title">
      <div class="programs-shell">
        <h2 id="winter-registration-title" class="sr-only">Complete your enrollment</h2>
        <div class="winter-registration-layout">
        <div class="winter-details-panel">
          <form class="winter-registration-form" data-winter-form>
            <p class="winter-form-intro">All fields are required unless marked optional.</p>
            <fieldset class="winter-form-group"><legend>Your young maker</legend>
              <div class="winter-form-row winter-child-row"><label>Child’s full name<input name="studentName" autocomplete="section-child name" maxlength="100" required /></label><label>Age<input name="studentAge" type="number" min="4" max="12" step="1" inputmode="numeric" required /></label></div>
            </fieldset>
            <fieldset class="winter-form-group"><legend>Parent or guardian</legend>
              <label>Full name<input name="parentName" autocomplete="section-parent name" maxlength="100" required /></label>
              <div class="winter-form-row"><label>Email address<input name="parentEmail" type="email" autocomplete="email" maxlength="120" required /></label><label>Phone number<input name="phone" type="tel" autocomplete="tel" maxlength="40" required /></label></div>
            </fieldset>
            <details class="winter-discount-panel"><summary>Have a discount or referral code?</summary><RegistrationDiscount /></details>
            <div class="winter-payment-actions">
            <button class="button button-primary" type="submit" data-winter-checkout aria-describedby="winter-payment-status" disabled>Continue to Secure Payment <span aria-hidden="true">→</span></button>
            <p id="winter-payment-status" class="winter-payment-status" data-winter-status role="status" aria-live="polite">Online payment is not available yet. Email us to register.</p>
            <a class="winter-email-registration" href={registrationUrl}>Register by email <span aria-hidden="true">↗</span></a>
            </div>
          </form>
        </div>
        <aside class="winter-visit winter-cart" aria-labelledby="winter-cart-title">
          <div class="winter-summary-heading"><h3 id="winter-cart-title">Your booking</h3><a href="#winter-dates">Edit <span aria-hidden="true">↗</span><span class="sr-only"> camps</span></a></div>
          <p class="winter-summary-note">1 child <span aria-hidden="true">·</span> Prices in CAD</p>
          <ul class="winter-cart-items" data-winter-cart><li>Select a camp above to get started.</li></ul>
          <dl class="winter-cart-totals" data-winter-totals hidden><div><dt>Subtotal</dt><dd data-winter-subtotal></dd></div><div data-winter-tax-row><dt data-winter-tax-label>Tax</dt><dd data-winter-tax></dd></div><div><dt data-winter-total-label>Total (CAD)</dt><dd data-winter-total></dd></div></dl>
          <button class="winter-clear-cart" type="button" data-winter-clear disabled hidden>Remove all camps</button>
          <div class="winter-cart-location"><a href="https://www.google.com/maps/search/?api=1&query=3445+Yonge+Street+Toronto" target="_blank" rel="noopener">{winterCamp.address} ↗</a></div>
        </aside>
        </div>
      </div>
    </section>

      </div>
    </div>

    <section class="camps-faq" aria-labelledby="winter-faq-title">
      <div class="programs-shell camps-faq-layout">
        <div><span class="eyebrow">GOOD TO KNOW</span><h2 id="winter-faq-title">A few winter<br />camp questions.</h2><p>Need a hand planning your child’s break? <a href={registrationUrl}>Email the studio.</a></p></div>
        <div class="camps-faq-list">
          <details><summary>What ages can attend?</summary><p>Winter Camp is for children ages 4–12.</p></details>
          <details><summary>Which dates can we choose?</summary><p>Christmas Camp runs December 21–24, 2026. Winter Break Camp runs December 28–31, 2026. Each camp runs Monday through Thursday.</p></details>
          <details><summary>Are prices per week?</summary><p>Yes. Both weeks have the same prices per child: $320.00 for one four-day week, 8 AM–3 PM. Optional extended care costs $10.00 per hour, per child, until 6 PM on eligible days. A week with 6 PM pickup on all three eligible days is $410.00, before applicable taxes.</p></details>
          <details><summary>Is extended care available?</summary><p>Extended care runs 3–6 PM at $10.00 per hour, per child, on December 21–23 for Christmas Camp and December 28–30 for Winter Break Camp. Choose 4 PM (+$10), 5 PM (+$20), or 6 PM (+$30) pickup separately for each eligible day. Pickup on December 24 and 31 is at 3 PM.</p></details>
          <details><summary>Is food provided?</summary><p>Bring lunch and snacks from home for either week. Contact the studio to discuss dietary needs.</p></details>
          <details><summary>Can I register for both camps?</summary><p>Yes. Add Christmas Camp and Winter Break Camp to your cart for the same child. Complete a separate registration for another child. While online payment is being prepared, email <a href={`mailto:${winterCamp.email}`}>{winterCamp.email}</a> for pricing and registration.</p></details>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <script>
    import '../../scripts/winter-camp-checkout.js';
  </script>
  <script>
    const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    menuButton?.addEventListener('click', () => {
      const open = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!open));
      menu?.classList.toggle('is-open', !open);
    });
    menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
      menuButton?.setAttribute('aria-expanded', 'false');
      menu.classList.remove('is-open');
    }));
    document.addEventListener('keydown', event => {
      if (event.key !== 'Escape' || menuButton?.getAttribute('aria-expanded') !== 'true') return;
      menuButton.setAttribute('aria-expanded', 'false');
      menu?.classList.remove('is-open');
      menuButton.focus();
    });
  </script>

  <style>
    .winter-camp-page { --camp-green: #486d77; --camp-green-deep: #2b4b55; }
    .camps-hero-copy > .eyebrow { display: block; }
    .winter-hero-printing { top: 85px; right: 0; bottom: auto; width: 170px; height: 155px; transform: rotate(-4deg); }
    .winter-hero-printing img { object-position: 65% center; }
    .camps-experience { padding: 44px 0; }
    .camps-experience-layout { gap: 48px; align-items: center; }
    .camps-experience h2 { margin: 10px 0 12px; font-size: clamp(28px, 3vw, 36px); }
    .camps-experience-layout > div > p { max-width: 360px; font-size: 14px; }
    .camps-experience li { gap: 14px; padding: 14px 0; }
    .camps-experience li > span { width: 30px; height: 30px; }
    .camps-experience h3 { margin-bottom: 4px; font-size: 19px; }
    .winter-date-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: stretch; }
    #winter-dates { padding: 40px 0 28px; }
    #winter-dates .camps-section-heading { gap: 24px; margin-bottom: 22px; }
    #winter-dates h2 { font-size: clamp(28px, 3vw, 36px); }
    #winter-dates .camps-section-heading > p { font-size: 14px; }
    .winter-date-card { display: flex; flex-direction: column; min-width: 0; padding: 18px; border: 1px solid var(--line); border-top: 4px solid #9f4e3e; border-radius: 16px; background: white; box-shadow: 0 8px 28px #1e3a5f06; }
    .winter-date-card:nth-child(2) { border-top-color: var(--camp-green); }
    .winter-date-card h3 { margin: 0 0 5px; font-size: 24px; }
    .winter-date-range { margin: 0; color: var(--muted); font-size: 15px; }
    .winter-session-hours { margin: 4px 0 12px; color: var(--muted); font-size: 12px; }
    .winter-booking-options { display: grid; gap: 6px; margin: 0 0 12px; }
    .winter-week-price { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px; border: 1px solid var(--line); border-radius: 14px; background: linear-gradient(135deg, var(--paper-alt), white); color: var(--ink); }
    .winter-week-price strong, .winter-week-price small { display: block; }
    .winter-week-price small { margin-top: 4px; color: var(--muted); font-size: 12px; font-weight: 400; }
    .winter-week-price > span > small:first-child { margin: 0 0 5px; font-size: 9px; font-weight: 700; letter-spacing: .1em; }
    .winter-week-price strong { font-size: 16px; }
    .winter-week-price b { font-size: clamp(22px, 2vw, 26px); text-align: right; letter-spacing: -.04em; }
    .winter-week-price b small { letter-spacing: 0; }
    .winter-care-options { min-width: 0; margin: 16px 0 0; }
    .winter-care-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .winter-care-heading h4 { margin: 0; color: var(--ink); font-size: 18px; }
    .winter-care-heading > span { padding: 5px 8px; border-radius: 20px; background: var(--paper-alt); color: var(--muted); font-size: 9px; font-weight: 700; letter-spacing: .08em; }
    .winter-care-help { margin: 6px 0 8px; color: var(--muted); font-size: 12px; line-height: 1.6; }
    .winter-pickup-day { min-width: 0; margin: 12px 0 0; padding: 0; border: 0; }
    .winter-pickup-day legend { margin-bottom: 6px; color: var(--ink); font-size: 12px; font-weight: 700; }
    .winter-pickup-day legend > span:first-child { margin-right: 8px; color: var(--muted); font-size: 9px; letter-spacing: .08em; }
    .winter-pickup-tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
    .winter-pickup-tile { position: relative; min-width: 0; cursor: pointer; }
    .winter-pickup-tile input { position: absolute; width: 1px; height: 1px; opacity: 0; }
    .winter-pickup-tile > span { display: grid; gap: 3px; justify-items: center; min-height: 44px; padding: 8px 3px; border: 1px solid var(--line); border-radius: 10px; background: white; color: var(--ink); transition: background .15s, border-color .15s; }
    .winter-pickup-tile strong { font-size: 17px; line-height: 1.2; }
    .winter-pickup-tile strong small { font-size: 10px; font-weight: 500; }
    .winter-pickup-tile em { color: var(--muted); font-size: 10px; font-style: normal; }
    .winter-pickup-tile:hover > span { border-color: var(--ink); background: var(--paper-alt); }
    .winter-pickup-tile input:checked + span { border-color: var(--ink); background: var(--ink); color: white; box-shadow: 0 3px 8px #1e3a5f18; }
    .winter-pickup-tile input:checked + span em { color: white; }
    .winter-pickup-tile input:focus-visible + span { outline: 3px solid var(--orange); outline-offset: 3px; }
    .winter-pickup-tile input:disabled + span { opacity: .55; cursor: wait; }
    .winter-pickup-notice { display: flex; align-items: center; gap: 10px; margin: 12px 0 4px; padding: 10px; border: 1px dashed var(--kraft); border-radius: 10px; background: var(--paper-alt); color: var(--ink); font-size: 11px; line-height: 1.6; }
    .winter-pickup-notice p { margin: 0; }
    .winter-pickup-notice p > strong { display: block; font-size: 13px; }
    .winter-final-day { flex: 0 0 38px; color: var(--muted); font-size: 9px; letter-spacing: .08em; text-align: center; }
    .winter-final-day strong { display: block; color: var(--ink); font-size: 21px; line-height: 1.2; letter-spacing: 0; }
    .winter-price-breakdown { display: grid; gap: 6px; margin: 10px 0; padding-top: 12px; border-top: 1px solid var(--line); color: var(--muted); font-size: 12px; }
    .winter-price-breakdown div { display: flex; justify-content: space-between; gap: 12px; }
    .winter-price-breakdown dd { margin: 0; color: var(--ink); font-weight: 700; }
    .winter-package-options { display: grid; gap: 9px; min-width: 0; margin: 0 0 6px; padding: 0; border: 0; }
    .winter-package-options legend, .winter-daily-options legend { margin-bottom: 8px; color: var(--ink); font-size: 12px; font-weight: 700; }
    .winter-package-option { display: flex; align-items: center; gap: 10px; min-height: 56px; padding: 9px 12px; border: 1px solid var(--line); border-radius: 10px; cursor: pointer; transition: border-color .15s, background .15s; }
    .winter-package-option:hover { border-color: var(--camp-green); }
    .winter-package-option:has(input:checked) { border-color: var(--ink); background: var(--paper-alt); box-shadow: inset 0 0 0 1px var(--ink); }
    .winter-package-option input { flex: 0 0 auto; width: 17px; height: 17px; margin: 0; accent-color: var(--camp-green-deep); }
    .winter-package-option > span { flex: 1; min-width: 0; }
    .winter-package-option strong { display: block; color: var(--ink); font-size: 13px; }
    .winter-package-option small { display: block; margin-top: 3px; color: var(--muted); font-size: 11px; font-weight: 400; }
    .winter-package-option > b { color: var(--ink); font-size: 15px; text-align: right; white-space: nowrap; }
    .winter-package-option > b small { display: inline; margin-left: 2px; }
    .winter-daily-options { display: grid; gap: 10px; min-width: 0; margin: 4px 0; padding: 15px; border: 1px solid var(--line); border-radius: 8px; }
    .winter-daily-options[hidden] { display: none; }
    .winter-day-option { display: grid; gap: 7px; }
    .winter-day-option label { display: flex; align-items: center; gap: 8px; color: var(--ink); font-size: 12px; }
    .winter-day-option label > span { margin-left: auto; color: var(--muted); }
    .winter-day-option .winter-day-care { padding-left: 22px; color: var(--muted); font-size: 10px; }
    .winter-day-option input { accent-color: var(--camp-green); }
    .winter-care-note { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.6; }
    .winter-camp-practical { color: var(--muted); font-size: 12px; }
    .winter-camp-practical summary { display: flex; align-items: center; min-height: 32px; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
    .winter-camp-practical summary::after { content: '+'; margin-left: 8px; }
    .winter-camp-practical[open] summary::after { content: '−'; }
    .winter-price-pending { margin-bottom: 24px; padding: 22px; border: 1px dashed var(--kraft); border-radius: 12px; background: var(--paper); color: var(--ink); }
    .winter-price-pending strong { font-size: 15px; }
    .winter-price-pending p { margin: 6px 0 14px; color: var(--muted); font-size: 13px; }
    .winter-price-pending a { font-size: 13px; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }
    .winter-date-card.is-selected { border-color: var(--camp-green); box-shadow: 0 0 0 2px var(--camp-green), var(--shadow); }

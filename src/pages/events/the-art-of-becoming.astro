---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
const weeks = [
  { date: 'February 3', title: 'The Shape of Our Expectations', text: 'Explore how expectations shape the way we create and live. Livia shares the pottery experience behind the bowl-versus-plate metaphor, followed by a book reflection and a beginner-friendly hand-built bowl.' },
  { date: 'February 10', title: 'Beautifully Imperfect', text: 'Reflect on patience and acceptance through Livia’s story of recovery after a ski accident. Create an organic textured dish or vessel, embracing unexpected marks and uneven edges.' },
  { date: 'February 17', title: 'The Things That Hold Us Together', text: 'Explore relationships and meaningful connection through Livia’s 40 Dates to Celebrate 40 experience. Create a small dish, paired forms or a decorative object symbolizing connection.' },
  { date: 'February 24', title: 'Enough, Just as It Is', text: 'Bring the journey together through appreciation and intention. Reflect on what fills your bowl, and glaze or personalize earlier work if firing timelines permit; otherwise, enjoy a suitable finishing project.' },
];
---
<BaseLayout title="The Art of Becoming | SparkPreneurs Toronto" description="Join Livia Grujich and SparkPreneurs for four evenings of pottery, storytelling and reflection in Toronto.">
  <SiteHeader current="events" ctaHref="#registration" ctaLabel="Reserve Your Spot" />
  <main class="standard-page event-detail-page">
    <section class="standard-hero"><div class="standard-shell standard-hero-grid"><div><span class="eyebrow">Special Experiences with Livia Grujich</span><h1>The Art of Becoming</h1><h2>A Journey Through Words &amp; Clay</h2><p><strong>Featuring author Livia Grujich</strong><br />In collaboration with SparkPreneurs Art &amp; Wellness Studio</p><p><em>Create with intention. Embrace imperfection. Discover the beauty of the present.</em></p><p>Four meaningful evenings of creativity, personal reflection and connection.</p><p><strong>February 3, 10, 17 &amp; 24, 2027</strong></p><a class="button button-primary" href="#registration">Reserve Your Spot</a></div><figure><img src="/images/livia-grujich-book.jpg" alt="Front cover of Stop Searching for Next by Livia Grujich" style="object-fit:contain" /></figure></div></section>
    <section class="standard-section"><div class="standard-shell story-grid"><div><span class="eyebrow">ABOUT THE EXPERIENCE</span><h2>More Than a Pottery Workshop</h2></div><div><p>You spend so much time creating a life. When was the last time you took time to enjoy it?</p><p>Between work, family, responsibilities and the endless pursuit of what's next, it's easy to lose sight of the life we're already living.</p><p>Join SparkPreneurs and Toronto author Livia Grujich for an intimate four-week experience combining hand-built pottery, personal storytelling, reflection and meaningful conversation.</p><p>Inspired by Livia's book, <em>Stop Searching for Next</em>, this series brings the book's central metaphor to life through the art of shaping clay. Just as we can become so focused on creating the perfect bowl that we forget to enjoy working with the clay, we can become so focused on building the perfect life that we overlook the beauty of the one we're already living.</p><p>Each week, Livia shares a personal story and selected reading, followed by individual reflection and a guided pottery activity connected to the evening's theme. No previous pottery experience or advance reading is required. Personal sharing is always optional.</p></div></div></section>
    <section class="standard-section standard-section-alt"><div class="standard-shell"><div class="standard-heading"><span class="eyebrow">FOUR WEDNESDAYS</span><h2>Your Four-Week Journey</h2></div><div class="event-type-grid">{weeks.map((week, index) => <article class="event-type-card"><span>WEEK {index + 1} · {week.date}</span><h3>{week.title}</h3><p>{week.text}</p></article>)}</div></div></section>
    <section class="standard-section"><div class="standard-shell story-grid"><div><span class="eyebrow">THE BOOK</span><h2>Stop Searching for Next</h2></div><div><p>Livia Grujich's book inspires the series. Each participant receives a paperback copy and can write privately in response to its existing chapter reflection questions.</p><p>Livia, a Toronto author, leads the storytelling, readings and conversation. A SparkPreneurs pottery instructor guides the clay activities.</p></div></div></section>
    <section class="standard-section standard-section-alt"><div class="standard-shell story-grid"><div><span class="eyebrow">THE DETAILS</span><h2>What's Included</h2></div><div><ul class="event-confirmed-list"><li>Four two-hour sessions</li><li>A personal paperback copy of <em>Stop Searching for Next</em></li><li>Guided pottery instruction, materials and studio services</li><li>Stories, private reflection and optional conversation</li></ul><p><strong>Dates:</strong> Wednesdays, February 3, 10, 17 &amp; 24, 2027<br /><strong>Time:</strong> Wednesdays, 6:30–8:30 p.m.<br /><strong>Location:</strong> SparkPreneurs, 3445 Yonge St., Second Floor, Toronto, ON M4N 2N1<br /><strong>Audience:</strong> Mature youth and adults are welcome<br /><strong>Price:</strong> $349 for four sessions<br /><strong>Early registration:</strong> $329 until December 24, 2026</p></div></div></section>
    <section id="registration" class="standard-section"><div class="standard-shell event-inquiry-panel"><div><span class="eyebrow">REGISTRATION</span><h2>Reserve Your Spot</h2><p>Contact us to express your interest and ask about registration.</p><a class="button button-primary" href="mailto:sparkpreneurs.ca@gmail.com?subject=The%20Art%20of%20Becoming%20Inquiry">Ask About This Experience</a></div><div><h3>Frequently Asked Questions</h3><p><strong>Do I need pottery experience or to read the book beforehand?</strong><br />No experience or advance reading is needed.</p><p><strong>Do I have to share personal reflections?</strong><br />No. Sharing is always optional.</p><p><strong>When can I collect my pottery?</strong><br />The instructor will confirm finishing and collection arrangements based on firing schedules.</p><p><strong>Is this therapy?</strong><br />This is a creative reflection experience, not therapy.</p></div></div></section>
  </main><SiteFooter />
  <script is:inline>(()=>{const b=document.querySelector('[data-menu-button]'),m=document.querySelector('[data-menu]');b?.addEventListener('click',()=>{const o=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!o));m?.classList.toggle('is-open',!o);});})();</script>
</BaseLayout>

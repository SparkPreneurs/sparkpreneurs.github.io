---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProgramHero from '../../components/ProgramHero.astro';
import ProgramNav from '../../components/ProgramNav.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const cohorts = [
  {
    value: 'pottery-wheel-mon-evening',
    itemCode: 'POTTERY_WHEEL_MON_EVENING',
    label: 'Monday Evening Cohort',
    name: 'Monday Evenings',
    time: '5:30 PM–7:30 PM',
    datesText: 'October 5, 12, 19 and 26',
    dates: [
      ['2026-10-05', 'October 5'], ['2026-10-12', 'October 12'],
      ['2026-10-19', 'October 19'], ['2026-10-26', 'October 26'],
    ],
  },
  {
    value: 'pottery-wheel-fri-daytime',
    // Retain the existing checkout product identifier until the backend is migrated.
    itemCode: 'POTTERY_WHEEL_TUE_DAYTIME',
    label: 'Friday Morning Cohort',
    name: 'Friday Mornings',
    time: '11:00 AM–1:00 PM',
    datesText: 'October 2, 9, 16 and 23',
    dates: [
      ['2026-10-02', 'October 2'], ['2026-10-09', 'October 9'],
      ['2026-10-16', 'October 16'], ['2026-10-23', 'October 23'],
    ],
  },
  {
    value: 'pottery-wheel-wed-evening',
    itemCode: 'POTTERY_WHEEL_WED_EVENING',
    label: 'Wednesday Evening Cohort',
    name: 'Wednesday Evenings',
    time: '5:30 PM–7:30 PM',
    datesText: 'October 7, 14, 21 and 28',
    dates: [
      ['2026-10-07', 'October 7'], ['2026-10-14', 'October 14'],
      ['2026-10-21', 'October 21'], ['2026-10-28', 'October 28'],
    ],
  },
  {
    value: 'pottery-wheel-sat-afternoon',
    itemCode: 'POTTERY_WHEEL_SAT_AFTERNOON',
    label: 'Saturday Afternoon Cohort',
    name: 'Saturday Afternoons',
    time: '1:00 PM–3:00 PM',
    datesText: 'October 3, 10, 17 and 24',
    dates: [
      ['2026-10-03', 'October 3'], ['2026-10-10', 'October 10'],
      ['2026-10-17', 'October 17'], ['2026-10-24', 'October 24'],
    ],
  },
];

const included = [
  'All clay, tools, and class materials',
  'Step-by-step instructor guidance',
  'Glazing and kiln firing for one finished piece',
  'Use of pottery wheels during class',
  'Studio cleanup and basic finishing support',
];

const skills = [
  'Preparing clay', 'Centring clay on the wheel', 'Opening and shaping a form',
  'Creating cylinders, bowls, or simple vessels', 'Controlling wall thickness',
  'Trimming and refining', 'Basic surface decoration',
  'Preparing one piece for glazing and firing', 'Safe use and care of pottery tools',
  'Building confidence through practice',
];
---

<BaseLayout title="Pottery Wheel Classes for Adults | SparkPreneurs Toronto" description="Join a four-session adult pottery wheel course at SparkPreneurs in Toronto. Learn wheel throwing with clay, tools, guidance, glazing, and firing for one piece included.">
  <SiteHeader current="programs" ctaHref="#registration" ctaLabel="Register" />

  <ProgramNav current="adults" />

  <main class="program-page pottery-wheel-page">
    <ProgramHero
      eyebrow="ADULT PROGRAM · MIDTOWN TORONTO"
      title="Pottery Wheel"
      intro="Learn to centre, shape, and finish your own pottery in four guided sessions. Small classes, all materials included, and no experience needed."
      image="/images/potter-wheel-hero.jpg"
      imageAlt="Adult shaping clay on a pottery wheel at SparkPreneurs"
      imageCaption="A little clay. A little calm. Something you made."
      programNumber=""
      backHref="/programs/adults/"
      backLabel="Back to Adult Programs"
      facts={[
        { label: 'Course', value: '4 sessions' },
        { label: 'Class length', value: '2 hours' },
        { label: 'Experience', value: 'Beginner friendly' },
        { label: 'Course price', value: '$250' },
      ]}
    >
      <Fragment slot="actions">
        <a class="button button-primary" href="#schedule">Choose Your Schedule <span aria-hidden="true">→</span></a>
        <a class="button button-ghost" href="mailto:sparkpreneurs.ca@gmail.com">Ask a Question</a>
      </Fragment>
    </ProgramHero>



    <section id="schedule" class="course-section course-schedule" aria-labelledby="pottery-wheel-schedule-title">
      <div class="program-shell">
        <div class="course-section-heading">
          <span class="eyebrow">MAKE TIME TO MAKE SOMETHING</span>
          <h2 id="pottery-wheel-schedule-title">1. Choose Your Schedule</h2>
          <p>Choose one weekly time. You will attend all four dates shown on your card.</p>
        </div>
        <fieldset class="course-cohort-grid" data-pottery-wheel-cohorts>
          <legend class="sr-only">Available Pottery Wheel cohorts</legend>
          {cohorts.map((cohort) => (
            <label class="pottery-schedule-card" data-pottery-wheel-cohort-card>
              <input type="radio" name="potteryWheelCohort" value={cohort.value} data-item-code={cohort.itemCode} data-cohort-label={cohort.name} data-cohort-time={cohort.time} data-cohort-dates={cohort.datesText} required />
              <span class="pottery-schedule-header">
                <span class="pottery-session-tag">{cohort.name.split(' ')[1]}</span>
                <strong class="pottery-schedule-day">{cohort.name.split(' ')[0]}</strong>
                <span class="pottery-schedule-time">{cohort.time}</span>
                <svg class="pottery-schedule-art" width="48" height="42" viewBox="0 0 140 120" fill="none" aria-hidden="true"><circle cx="76" cy="64" r="49" stroke="currentColor" stroke-dasharray="3 7"/><ellipse cx="76" cy="43" rx="35" ry="9" stroke="currentColor" stroke-width="2"/><path d="M41 43c3 28 15 42 35 42s32-14 35-42M49 65c14 8 40 8 54 0M64 86v5h24v-5M45 99h62" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M21 25v12m-6-6h12m83 57v12m-6-6h12" stroke="currentColor" stroke-width="2"/></svg>
              </span>
              <span class="pottery-schedule-body">
                <span class="pottery-dates-heading"><strong>Your four studio sessions</strong><span>2 hours each</span></span>
                <span class="pottery-calendar-dates">{cohort.dates.map(([datetime, label], index) => <time datetime={datetime}><span class="pottery-session-number">{String(index + 1).padStart(2, '0')}</span><strong>{label.split(' ')[1]}</strong><span class="pottery-session-month">{label.split(' ')[0].slice(0, 3)}</span></time>)}</span>
              </span>
              <span class="pottery-schedule-footer"><span class="pottery-schedule-select"><span data-pottery-select-label>Choose this schedule</span><span class="pottery-schedule-arrow" aria-hidden="true">&rarr;</span></span></span>
            </label>
          ))}
        </fieldset>

      </div>
    </section>

    <section id="registration" class="course-section course-registration" aria-labelledby="pottery-wheel-registration-title">
      <div class="program-shell">
        <div class="course-section-heading course-section-heading--left">
          <span class="eyebrow">REGISTRATION</span>
          <h2 id="pottery-wheel-registration-title">2. Reserve Your Place</h2>
          <p>Choose a cohort, complete your details, and continue to secure payment.</p>
        </div>
        <div class="course-registration-grid" data-pottery-wheel-registration data-apps-script-url="https://script.google.com/macros/s/AKfycbwFjroZMc49w0S5ARgEY1X-pB-ZSkVnzlLEwtXm_re_tUUx9SfgPX3t4t8B2AG_yW31/exec" data-program-code="august_september_2026_pottery_wheel" data-required-stripe-mode="live">
          <div class="course-selection-panel">
            <header class="pottery-course-heading">
              <span class="tag">YOUR COURSE</span>
              <h3>Pottery Wheel</h3>
              <dl class="pottery-course-facts">
                <div><dt>Course length</dt><dd>4 sessions</dd></div>
                <div><dt>Each session</dt><dd>2 hours</dd></div>
              </dl>
            </header>
            <article class="course-selected-card">
              <span>Your schedule</span>
              <h3 data-pottery-wheel-selected-name>Choose your weekly time</h3>
              <p data-pottery-wheel-selected-time>Select a schedule above to get started.</p>
              <p data-pottery-wheel-selected-dates>All four class dates will appear here.</p>
              <a href="#schedule">Choose or change schedule <span aria-hidden="true">&uarr;</span></a>
            </article>
            <div class="pottery-registration-included">
              <h4>Included in your course</h4>
              <ul>
                <li>Clay, tools, and materials</li>
                <li>Guidance at every session</li>
                <li>Glazing and firing for one piece</li>
              </ul>
            </div>
            <div class="pottery-registration-price"><div><span class="eyebrow">COURSE PRICE</span><span class="pottery-offer-price"><strong>$250</strong></span></div><span>For all four sessions</span></div>
          </div>

          <aside class="course-registration-card" aria-label="Complete your Pottery Wheel registration">
            <span class="eyebrow">YOUR DETAILS</span>
            <h3>A few details, then you're ready.</h3>
            <p class="pottery-form-intro">Enter your contact details to continue to payment.</p>
            <form data-pottery-wheel-form novalidate>
              <div class="course-form-row">
                <label>First name<input type="text" name="firstName" autocomplete="given-name" required /></label>
                <label>Last name<input type="text" name="lastName" autocomplete="family-name" required /></label>
              </div>
              <div class="course-form-row"><label>Email<input type="email" name="email" autocomplete="email" required /></label><label>Phone<input type="tel" name="phone" autocomplete="tel" required /></label></div>
              <label>Experience level<select name="experienceLevel" required><option value="">Choose one</option><option value="beginner">Beginner</option><option value="some-experience">Some experience</option><option value="experienced">Experienced</option></select></label>
              <div class="pottery-discount" data-pottery-discount>
                <label>Discount code (optional)<input name="discountCode" type="text" maxlength="40" autocomplete="off" autocapitalize="characters" aria-describedby="pottery-discount-help" /></label>
                <button class="button button-ghost" type="button" data-pottery-discount-apply>Apply code</button>
                <p id="pottery-discount-help">Each code can be used once per email across all registrations.</p>
              </div>
              <dl class="pottery-discount-summary" data-pottery-discount-summary hidden aria-live="polite">
                <div><dt>Course price</dt><dd data-pottery-discount-subtotal></dd></div>
                <div><dt>Discount</dt><dd data-pottery-discount-saving></dd></div>
                <div><dt>Tax</dt><dd data-pottery-discount-tax></dd></div>
                <div><dt>Total</dt><dd data-pottery-discount-total></dd></div>
              </dl>
              <details class="pottery-message"><summary>Add a message (optional)</summary><label>Message<textarea name="message" rows="2"></textarea></label></details>
              <label class="course-consent"><input type="checkbox" name="consent" value="yes" required /><span>I agree to the registration and privacy terms.</span></label>
            </form>
            <p class="course-registration-note">Your cohort is not held until payment is verified.</p>
            <p class="course-registration-status" data-pottery-wheel-status role="status" aria-live="polite"></p>
            <button class="button button-primary course-checkout" type="button" data-pottery-wheel-submit disabled>Continue to Secure Payment</button>
            <button class="course-clear" type="button" data-pottery-wheel-clear>Clear selection</button>
          </aside>
        </div>
      </div>
    </section>

    <section id="course-details" class="course-section pottery-details" aria-labelledby="pottery-details-title">
      <div class="program-shell">
        <div class="course-section-heading course-section-heading--left"><h2 id="pottery-details-title">Course Details</h2><p>Everything you need to know before your first class.</p></div>
        <details class="pottery-detail">
          <summary>What's included</summary>
          <ul>{included.map((item) => <li>{item}</li>)}</ul>
          <p>Additional pieces may be glazed and kiln-fired for an extra fee.</p>
        </details>
        <details class="pottery-detail">
          <summary>What you'll learn</summary>
          <ul class="pottery-skills">{skills.map((skill) => <li>{skill}</li>)}</ul>
        </details>
        <details class="pottery-detail">
          <summary>Finished pieces &amp; pickup</summary>
          <p>Create and refine pottery over four sessions. One selected piece will be glazed and professionally kiln-fired as part of your course fee; additional pieces cost extra.</p>
          <p>Firing takes additional processing time. We'll share pickup timing during the course.</p>
        </details>
        <p class="pottery-question">Have a question? <a href="mailto:sparkpreneurs.ca@gmail.com">Email us</a></p>
      </div>
    </section>
  </main>

  <SiteFooter />

  <script is:inline>
    (() => {
      const menuButton = document.querySelector('[data-menu-button]');
      const menu = document.querySelector('[data-menu]');
      menuButton?.addEventListener('click', () => { const open = menuButton.getAttribute('aria-expanded') === 'true'; menuButton.setAttribute('aria-expanded', String(!open)); menu?.classList.toggle('is-open', !open); });

      const registration = document.querySelector('[data-pottery-wheel-registration]');
      const cohortInputs = [...document.querySelectorAll('[data-pottery-wheel-cohorts] input[type="radio"]')];
      if (!registration || !cohortInputs.length) return;

      const form = registration.querySelector('[data-pottery-wheel-form]');
      const selectedName = registration.querySelector('[data-pottery-wheel-selected-name]');
      const selectedTime = registration.querySelector('[data-pottery-wheel-selected-time]');
      const selectedDates = registration.querySelector('[data-pottery-wheel-selected-dates]');
      const submitButton = registration.querySelector('[data-pottery-wheel-submit]');
      const clearButton = registration.querySelector('[data-pottery-wheel-clear]');
      const status = registration.querySelector('[data-pottery-wheel-status]');
      const appsScriptUrl = registration.dataset.appsScriptUrl || '';
      const programCode = registration.dataset.programCode || '';
      const requiredStripeMode = registration.dataset.requiredStripeMode || 'test';
      // The payment service allows the original route; Netlify redirects it to this page.
      const returnPageUrl = 'https://sparkpreneurs.ca/pottery-wheel/';
      let backendReady = false;
      let isSubmitting = false;
      let discountsSupported = false;
      let appliedQuote = null;
      const quotePanel = registration.querySelector('[data-pottery-discount-summary]');
      const discountInput = form.querySelector('[name="discountCode"]');
      const emailInput = form.querySelector('[name="email"]');
      const quoteKey = () => JSON.stringify([
        selectedInput()?.dataset.itemCode || '', emailInput.value.trim().toLowerCase(),
        discountInput.value.trim().toUpperCase(),
      ]);
      const resetQuote = () => { appliedQuote = null; quotePanel.hidden = true; };

      const setStatus = (message, type = '') => { status.textContent = message || ''; status.dataset.status = type; };
      const selectedInput = () => cohortInputs.find((input) => input.checked) || null;
      const updateSelection = () => {
        const input = selectedInput();
        cohortInputs.forEach((item) => {
          const card = item.closest('[data-pottery-wheel-cohort-card]');
          card?.classList.toggle('is-selected', item.checked);
          const label = card?.querySelector('[data-pottery-select-label]');
          if (label) label.textContent = item.checked ? 'Selected schedule' : 'Choose this schedule';
        });
        if (!input) {
          selectedName.textContent = 'Choose your weekly time';
          selectedTime.textContent = 'Select a schedule above to get started.';
          selectedDates.textContent = 'All four class dates will appear here.';
          submitButton.disabled = true;
          clearButton.disabled = isSubmitting;
          return;
        }
        selectedName.textContent = input.dataset.cohortLabel || '';
        selectedTime.textContent = input.dataset.cohortTime || '';
        selectedDates.textContent = input.dataset.cohortDates || '';
        submitButton.disabled = !backendReady || isSubmitting;
        clearButton.disabled = isSubmitting;
      };
      const post = async (payload) => {
        const response = await fetch(appsScriptUrl, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify(payload) });
        const responseText = await response.text();
        let result;
        try { result = JSON.parse(responseText); } catch { throw new Error('The registration service did not return a readable response.'); }
        if (!response.ok || result.success === false) throw new Error(result.error || 'The registration service could not process this request.');
        return result;
      };
      const checkBackend = async () => {
        if (!appsScriptUrl || !programCode) { setStatus('Secure checkout is temporarily unavailable. Please contact SparkPreneurs.', 'warning'); updateSelection(); return; }
        setStatus('Preparing secure checkout…', 'pending');
        try { const result = await post({ action: 'ping', programCode }); backendReady = result.programCode === programCode && result.stripeMode === requiredStripeMode; discountsSupported = backendReady && result.discountsSupported === true; setStatus(backendReady ? '' : 'Secure checkout is temporarily unavailable. Please contact SparkPreneurs.', backendReady ? '' : 'warning'); }
        catch { backendReady = false; setStatus('Secure checkout is temporarily unavailable. Please contact SparkPreneurs.', 'warning'); }
        updateSelection();
      };
      const requestQuote = async () => {
        if (!discountsSupported) throw new Error('Discount codes are temporarily unavailable. Remove the code to continue without a discount, or contact SparkPreneurs.');
        const input = selectedInput();
        if (!input) throw new Error('Please choose a schedule before applying a discount.');
        if (!emailInput.reportValidity()) throw new Error('Enter your email before applying a discount.');
        const key = quoteKey();
        const result = await post({ action: 'quoteCheckout', programCode,
          selectedItemCodes: [input.dataset.itemCode], email: emailInput.value.trim(),
          discountCode: discountInput.value.trim() });
        if (key !== quoteKey()) throw new Error('Your details changed. Please apply the code again.');
        for (const field of ['subtotalCents', 'discountCents', 'taxCents', 'expectedAmountCents']) {
          if (!Number.isSafeInteger(result[field]) || result[field] < 0) throw new Error('The registration service returned an invalid total.');
        }
        if (result.subtotalCents - result.discountCents + result.taxCents !== result.expectedAmountCents || result.expectedAmountCents <= 0) {
          throw new Error('The registration service returned an invalid total.');
        }
        appliedQuote = { ...result, key };
        const money = cents => new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD' }).format(cents / 100);
        registration.querySelector('[data-pottery-discount-subtotal]').textContent = money(result.subtotalCents);
        registration.querySelector('[data-pottery-discount-saving]').textContent = '-' + money(result.discountCents);
        registration.querySelector('[data-pottery-discount-tax]').textContent = money(result.taxCents);
        registration.querySelector('[data-pottery-discount-total]').textContent = money(result.expectedAmountCents);
        quotePanel.hidden = false;
      };
      registration.querySelector('[data-pottery-discount-apply]').addEventListener('click', async () => {
        if (isSubmitting) return;
        resetQuote(); isSubmitting = true; updateSelection(); setStatus('Checking your code and total…', 'pending');
        try { await requestQuote(); setStatus('Your total is ready. Continue to secure payment when you are ready.', 'success'); }
        catch (error) { resetQuote(); setStatus(error.message || 'The discount could not be checked.', 'error'); }
        finally { isSubmitting = false; updateSelection(); }
      });
      emailInput.addEventListener('input', resetQuote);
      discountInput.addEventListener('input', resetQuote);
      const replaceCheckoutQuery = () => { const url = new URL(location.href); url.searchParams.delete('session_id'); url.searchParams.delete('payment'); history.replaceState({}, document.title, url.pathname + url.search + url.hash); };
      const verifyReturn = async () => {
        const params = new URLSearchParams(location.search); const sessionId = params.get('session_id'); const payment = params.get('payment');
        if (payment === 'cancelled' || payment === 'canceled') { setStatus('Payment was canceled. Your cohort selection is still available when you are ready.', 'warning'); registration.scrollIntoView({ behavior: 'smooth', block: 'start' }); replaceCheckoutQuery(); return; }
        if (!sessionId || !appsScriptUrl) return;
        setStatus('Checking payment status…', 'pending'); registration.scrollIntoView({ behavior: 'smooth', block: 'start' });
        try { const result = await post({ action: 'verifyCheckoutSession', programCode, stripeSessionId: sessionId }); if (result.paymentStatus !== 'paid') throw new Error('Payment could not be verified yet. Please contact SparkPreneurs.'); setStatus(result.message || 'Payment verified. Your registration has been received.', 'success'); }
        catch (error) { setStatus(error.message || 'Payment could not be verified yet. Please contact SparkPreneurs.', 'error'); }
        finally { replaceCheckoutQuery(); }
      };
      const beginCheckout = async () => {
        if (isSubmitting) return;
        const input = selectedInput();
        if (!input) { setStatus('Please choose one four-session cohort before continuing.', 'warning'); document.querySelector('#schedule')?.scrollIntoView({ behavior: 'smooth', block: 'start' }); return; }
        if (!backendReady) { setStatus('Secure checkout is temporarily unavailable. Please contact SparkPreneurs.', 'warning'); return; }
        if (!form.reportValidity()) { setStatus('Please complete the required registration fields before continuing.', 'warning'); return; }
        if (discountInput.value.trim() && !discountsSupported) { setStatus('Discount codes are temporarily unavailable. Remove the code to continue without a discount, or contact SparkPreneurs.', 'warning'); return; }
        if (discountsSupported && (!appliedQuote || appliedQuote.key !== quoteKey())) {
          isSubmitting = true; updateSelection();
          try { await requestQuote(); setStatus('Review the total above, then click Continue to Secure Payment again.', 'pending'); }
          catch (error) { resetQuote(); setStatus(error.message || 'Your total could not be checked.', 'error'); }
          finally { isSubmitting = false; updateSelection(); }
          return;
        }
        const values = new FormData(form);
        const itemCode = input.dataset.itemCode;
        if (!itemCode) { setStatus('Please choose a valid cohort before continuing.', 'warning'); return; }
        isSubmitting = true; submitButton.textContent = 'Opening Secure Payment…'; updateSelection(); setStatus('Checking your cohort and registration total…', 'pending');
        try {
          const result = await post({ action: 'createCheckoutSession', programCode, selectedItemCodes: [itemCode], discountCode: discountsSupported ? appliedQuote.discountCode : '', displayedAmountCents: discountsSupported ? appliedQuote.expectedAmountCents : 25000, successUrl: `${returnPageUrl}?payment=success&session_id={CHECKOUT_SESSION_ID}`, cancelUrl: `${returnPageUrl}?payment=cancelled#registration`, firstName: String(values.get('firstName') || '').trim(), lastName: String(values.get('lastName') || '').trim(), email: String(values.get('email') || '').trim(), phone: String(values.get('phone') || '').trim(), experienceLevel: String(values.get('experienceLevel') || '').trim(), message: String(values.get('message') || '').trim(), consent: values.get('consent') === 'yes' });
          const checkoutUrl = new URL(result.checkoutUrl);
          if (checkoutUrl.protocol !== 'https:' || checkoutUrl.hostname !== 'checkout.stripe.com') throw new Error('Stripe returned an invalid payment link.');
          location.assign(checkoutUrl.href);
        } catch (error) { isSubmitting = false; submitButton.textContent = 'Continue to Secure Payment'; setStatus(error.message || 'Payment could not be started. Please try again.', 'error'); updateSelection(); }
      };

      cohortInputs.forEach((input) => input.addEventListener('change', () => { resetQuote(); setStatus(''); updateSelection(); }));
      clearButton.addEventListener('click', () => { cohortInputs.forEach((input) => { input.checked = false; }); form.reset(); resetQuote(); setStatus('Your cohort selection and form details were cleared.', 'warning'); updateSelection(); });
      form.addEventListener('submit', (event) => { event.preventDefault(); beginCheckout(); });
      submitButton.addEventListener('click', beginCheckout);
      updateSelection(); checkBackend(); verifyReturn();
    })();
  </script>
</BaseLayout>

<style>
  .pottery-discount { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; align-items: end; }
  .pottery-discount[hidden], .pottery-discount-summary[hidden] { display: none; }
  .pottery-discount .button { padding: 10px 12px; font-size: 12px; }
  .pottery-discount p { grid-column: 1 / -1; margin: 0; color: var(--muted); font-size: 12px; }
  .pottery-discount-summary { margin: 0; padding: 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--paper); }
  .pottery-discount-summary > div { display: flex; justify-content: space-between; gap: 12px; padding: 4px 0; }
  .pottery-discount-summary dd { margin: 0; font-weight: 700; }
  .pottery-discount-summary > div:last-child { border-top: 1px solid var(--line); margin-top: 6px; padding-top: 10px; }
  .pottery-offer-price { display: inline-flex; flex-wrap: wrap; gap: 0.5rem; align-items: baseline; }
  .pottery-offer-price del { color: #b42318; }
  .pottery-offer-price strong { font-weight: 700; }
  .pottery-wheel-page :global(.course-hero__copy) { padding: 24px 30px; }
  .pottery-wheel-page :global(.course-hero__copy h1) { font-size: clamp(36px, 4vw, 50px); }
  .pottery-wheel-page :global(.course-hero__media img) { position: absolute; inset: 0; }
  .pottery-wheel-page .course-section { padding: 32px 0; scroll-margin-top: 110px; }
  .pottery-wheel-page .course-section-heading { margin-bottom: 20px; text-align: left; max-width: none; }
  .pottery-wheel-page .course-section-heading h2 { margin: 6px 0 8px; font-size: clamp(26px, 3vw, 34px); }
  .pottery-wheel-page .course-section-heading > p { font-size: 14px; }
  .course-cohort-grid { gap: 18px; }
  .course-registration-grid { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 20px; }
